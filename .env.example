# .env.example — Gerçek değerlerle .env olarak kopyala
# DİKKAT: .env dosyasını asla Git'e commit etme!

# OpenRouter API (Anthropic modelleri için)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id_here
GROUP_CHAT_ID=your_group_chat_id_here

# Qdrant (lokal kurulum için varsayılan değerler)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# GitHub
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO_URL=https://github.com/your_username/your_repo.git

# Uygulama Ayarları
LOG_LEVEL=INFO
AGENT_BASE_PATH=/path/to/your/project

# OCR (Mistral kullanılacaksa)
MISTRAL_API_KEY=your_mistral_api_key_here
